<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.joegxx.localsql</groupId>
        <artifactId>localsql-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>localsql-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-spark</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-analyzer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-rewrite</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-duckdb</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-thrift</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>runtime</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.joegxx.localsql.app.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
