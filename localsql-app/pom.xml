<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.joegxx.localsql</groupId>
        <artifactId>localsql-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>localsql-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-spark</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-analyzer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-rewrite</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-duckdb</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-thrift</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.joegxx.localsql</groupId>
            <artifactId>localsql-udf-runtime</artifactId>
        </dependency>
        <!-- F3: the in-process Hive gateway needs the Hive UDF API at runtime.
             udf-runtime marks it provided (the old worker-jar plan); until a
             separate worker exists, runtime.jar carries it. Transitive deps are
             excluded: the API classes live in the hive-exec jar itself and user
             UDF JARs bring their own hadoop. -->
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-exec</artifactId>
            <version>${hive.version}</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Writable types (Text, IntWritable...) used by the simple-UDF and
             object-inspector conversion paths; user UDF JARs carry anything
             beyond these. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.4</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- hadoop-common's Configuration XML parsing pulls these in at runtime
             (WritableComparator → Text → Configuration.loadResource); without
             them simple-UDF calls fail with NoClassDefFoundError. -->
        <dependency>
            <groupId>com.fasterxml.woodstox</groupId>
            <artifactId>woodstox-core</artifactId>
            <version>5.0.3</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.codehaus.woodstox</groupId>
            <artifactId>stax2-api</artifactId>
            <version>4.2.1</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>runtime</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.joegxx.localsql.app.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
